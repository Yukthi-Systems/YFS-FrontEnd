# YFS-Main-API base URL (trailing slash optional)
VITE_API_URL=https://yfs-api.test.example.com/
# Yukthi SSO base URL (no trailing slash)
VITE_SSO_URL=https://sso.test.example.com
# App identifier registered with the SSO service (sent as ?app=<id>)
VITE_SSO_APP_ID=file
# Hosts Vite's dev server is allowed to be served on
VITE_ALLOWED_HOSTS=localhost,*.internal.my.id,*.my.id

# Storage API origin used for tus uploads when the upload session has no base_url
VITE_STORAGE_URL=https://store-1.files.test.example.com
# Collabora Online origin (document editing via WOPI)
VITE_COLLABORA_URL=https://collabora.example.com
# Optional: Collabora loader URL used when discovery.xml can't be fetched
# VITE_COLLABORA_LOADER_URL=https://collabora.example.com/browser/<hash>/cool.html?
