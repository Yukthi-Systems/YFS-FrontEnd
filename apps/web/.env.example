# YFS-Main-API base URL (trailing slash optional)
VITE_API_URL=https://yfs-api.test.example.com/
# Yukthi SSO base URL (no trailing slash)
VITE_SSO_URL=https://sso.test.example.com
# App identifier registered with the SSO service (sent as ?app=<id>)
VITE_SSO_APP_ID=file
# Hosts Vite's dev server is allowed to be served on
VITE_ALLOWED_HOSTS=localhost,*.internal.my.id,*.my.id
# File uploads: leave unset/true to mock signing + transfer locally (no backend
# needed). Set to "false" once YFS-Main-API's /files scope is live to use the real
# signed-URL + TUS path.
VITE_MOCK_UPLOADS=true
